<local:ModuleBaseDlg x:Class="BrainSimulator.Modules.ModuleAlgorithmDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BrainSimulator.Modules"
        mc:Ignorable="d"
        Title="Algorithm Module" Height="208" Width="550" Background="Gray" ShowInTaskbar="False" FontSize="16" >

    <Grid Margin="0,0,0,32" >
        <Label Content="Task:" Margin="26,8,470,0" Height="28" VerticalAlignment="Top" />
        <TextBox x:Name="taskInput" Height="28" Width="114" VerticalAlignment="Top" Margin="29,41,0,0" HorizontalAlignment="Left" ></TextBox>

        <Label Content="Param 1:" Margin="185,8,251,0" Height="28" VerticalAlignment="Top" />
        <TextBox x:Name="parameter1Input" Height="28" Width="114" VerticalAlignment="Top" Margin="188,41,0,0" HorizontalAlignment="Left" ></TextBox>

        <Label Content="Param 2:" Margin="317,8,113,0" Height="28" VerticalAlignment="Top" />
        <TextBox x:Name="parameter2Input" Height="28" Width="114" VerticalAlignment="Top" Margin="320,41,0,0" HorizontalAlignment="Left" ></TextBox>

        <Button x:Name="executeButton" Content="Execute" Height="28" VerticalAlignment="Top" Margin="0,41,16,0" HorizontalAlignment="Right" Width="80" />

        <Label Content="New Step:" Margin="23,101,0,0" Height="36" VerticalAlignment="Top" HorizontalAlignment="Left" Width="88" />
        <TextBox x:Name="newStepInput" Height="28" VerticalAlignment="Top" Margin="120,101,116,0" />

        <Button x:Name="addStepButton" Content="Add Step" Height="28" VerticalAlignment="Top" Margin="0,101,16,0" HorizontalAlignment="Right" Width="80" />
    </Grid>
</local:ModuleBaseDlg>