<local:ModuleBaseDlg x:Class="BrainSimulator.Modules.ModuleUKSQueryDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BrainSimulator.Modules"
        mc:Ignorable="d"
        Title="UKS Query" Height="550" Width="530" Background="Gray" ShowInTaskbar="False"  >
    <Grid Name="theGrid" Margin="0,0,0,0" >
        <TabControl Background="DarkGray" SelectedIndex="0" Margin="0,0,0,35">
            <TabItem Header="Get Attribs" FontSize="18" Background="LightGray" >
                <Grid Height="508">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="153*"/>
                        <ColumnDefinition Width="20*"/>
                        <ColumnDefinition Width="52*"/>
                        <ColumnDefinition Width="299*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="From"        HorizontalAlignment="Left"   Height="33"   Margin="10,20,0,0"       FontSize="16" Width="68" VerticalAlignment="Top"/>
                    <Label Content="Type"        HorizontalAlignment="Left"   Height="33"   Margin="10,70,0,0"    FontSize="16" Width="68" VerticalAlignment="Top"/>
                    <Label Content="To"      HorizontalAlignment="Left"   Height="33"   Margin="10,120,0,0"   FontSize="16" Width="68" VerticalAlignment="Top"/>
                    <Label Content="Filter"      HorizontalAlignment="Left"   Height="33"   Margin="10,170,0,0"   FontSize="16"  Width="68" VerticalAlignment="Top" />
                    <Label Content="Result"      HorizontalAlignment="Left"   Height="33"   Margin="10,280,0,0"   FontSize="16"  Width="68" VerticalAlignment="Top"/>

                    <TextBox  x:Name="sourceText"    TabIndex="1"  Height="33" VerticalAlignment="Top"   FontSize="16"   Margin="78,20,0,0" HorizontalAlignment="Left" Width="278" TextChanged="Text_TextChanged" Grid.ColumnSpan="4"/>
                    <TextBox  x:Name="typeText"      TabIndex="2"  Height="33" VerticalAlignment="Top"   FontSize="16"     Margin="78,70,0,0" HorizontalAlignment="Left" Width="278" TextChanged="Text_TextChanged" Grid.ColumnSpan="4"/>
                    <TextBox  x:Name="targetText"    TabIndex="3"  Height="33" VerticalAlignment="Top"   FontSize="16"   Margin="78,120,0,0" HorizontalAlignment="Left" Width="278"  TextChanged="Text_TextChanged" Grid.ColumnSpan="4"/>
                    <TextBox  x:Name="filterText"    TabIndex="4"  Height="33" VerticalAlignment="Top"   FontSize="16"   Margin="78,170,0,0" HorizontalAlignment="Left" Width="278" TextChanged="Text_TextChanged" Grid.ColumnSpan="4"/>
                    <TextBox  x:Name="resultText"    TabIndex="5"  FontSize="18" Margin="78,245,38,54"  TextWrapping="Wrap" Grid.ColumnSpan="4"/>

                    <Button x:Name="BtnLinks" IsDefault="True" Content="Query" Height="32" VerticalAlignment="Top" FontSize="16" Margin="149,21,0,0" Click="BtnLinks_Click" HorizontalAlignment="Left" Width="120" Grid.Column="3"/>
                    <Button x:Name="BtnWhy" Content="Why?" Height="32" VerticalAlignment="Top" FontSize="16" Margin="149,61,0,0" Click="BtnWhy_Click" HorizontalAlignment="Left" Width="120" Grid.Column="3"/>
                    <CheckBox x:Name="fullCB" Content="Show Full Links" FontSize="16" HorizontalAlignment="Left" Height="22" Margin="149,101,0,0" VerticalAlignment="Top" Width="226" Grid.Column="3"/>
                </Grid>
            </TabItem>
            <TabItem Header="Search by Attribs" FontSize="18" Background="LightGray" >
                <Grid>
                    <Label Content="Type"        HorizontalAlignment="Left"   Height="33"   Margin="10,20,0,0"    FontSize="16" Width="68" VerticalAlignment="Top" />
                    <Label Content="To"      HorizontalAlignment="Left"   Height="33"   Margin="10,70,0,0"   FontSize="16" Width="68" VerticalAlignment="Top" />
                    <Label Content="Ancestor"      HorizontalAlignment="Left"   Height="33"   Margin="10,120,0,0"   FontSize="16"  Width="75" VerticalAlignment="Top"  />
                    <Label Content="Query"      HorizontalAlignment="Left"   Height="33"   Margin="10,170,0,0"   FontSize="16"  Width="68" VerticalAlignment="Top"/>
                    <Label Content="Result"      HorizontalAlignment="Left"   Height="33"   Margin="15,336,0,0"   FontSize="16"  Width="68" VerticalAlignment="Top"/>

                    <TextBox  x:Name="typeText1"      TabIndex="2"  Height="33" VerticalAlignment="Top"   FontSize="16"     Margin="78,20,213,0" TextChanged="Text_TextChanged"  PreviewKeyDown="Text_PreviewKeyDown"/>
                    <TextBox  x:Name="targetText1"    TabIndex="3"  Height="33" VerticalAlignment="Top"   FontSize="16"   Margin="78,70,213,0" TextChanged="Text_TextChanged"  PreviewKeyDown="Text_PreviewKeyDown"/>
                    <TextBox  x:Name="ancestorText1"    TabIndex="4"  Height="32" VerticalAlignment="Top"   FontSize="16"   Margin="78,120,213,0" TextChanged="Text_TextChanged" PreviewKeyDown="Text_PreviewKeyDown"/>
                    <TextBox  x:Name="queryText1"    TabIndex="5"   FontSize="16" Margin="78,170,36,176"  TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" RenderTransformOrigin="0.5,0.5" />
                    <TextBox  x:Name="resultText1"    TabIndex="5"   FontSize="18" Margin="78,0,36,10"  TextWrapping="Wrap" Height="157" VerticalAlignment="Bottom"/>
                    <Button x:Name="BtnNew" IsDefault="True" Content="New" Height="32" VerticalAlignment="Top" FontSize="16" Margin="0,21,102,0" Click="BtnLinks_Click" HorizontalAlignment="Right" Width="63" />
                    <Button x:Name="BtnAdd" IsDefault="True" Content="Add" Height="32" VerticalAlignment="Top" FontSize="16" Margin="0,21,38,0" Click="BtnLinks_Click" HorizontalAlignment="Right" Width="63" />
                    <Button x:Name="BtnClear" Content="Clear" Height="32" VerticalAlignment="Top" FontSize="16" Margin="0,72,36,0" Click="BtnLinks_Click" HorizontalAlignment="Right" Width="127" />
                    <!--<Button x:Name="BtnLearn" Content="Learn" Height="32" VerticalAlignment="Top" FontSize="16" Margin="0,121,103,0" Click="BtnLearn_Click" HorizontalAlignment="Right" Width="60" />
                    <Button x:Name="BtnNo" Content="No" Height="32" VerticalAlignment="Top" FontSize="16" Margin="0,121,38,0" Click="BtnNo_Click" HorizontalAlignment="Right" Width="60" />-->
                </Grid>
            </TabItem>
        </TabControl>
        <CheckBox x:Name="CBAutoRefresh" Content="Auto-Refresh" IsChecked="True" HorizontalAlignment="Left" Margin="347,10,0,0" VerticalAlignment="Top"/>
    </Grid>
</local:ModuleBaseDlg>
