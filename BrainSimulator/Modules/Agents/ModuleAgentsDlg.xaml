<local:ModuleBaseDlg x:Class="BrainSimulator.Modules.ModuleAgentsDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BrainSimulator.Modules"
        Title="Agents" Height="330" Width="520" Background="Gray"
        ShowInTaskbar="False" FontSize="15">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel x:Name="AgentButtons" HorizontalAlignment="Left"/>
        <TextBox x:Name="StatusText" Grid.Row="1" Margin="0,14,0,0"
                 IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>
    </Grid>
</local:ModuleBaseDlg>
