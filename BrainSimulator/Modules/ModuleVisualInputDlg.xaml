<local:ModuleBaseDlg x:Class="BrainSimulator.Modules.ModuleVisualInputDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BrainSimulator.Modules"
        Title="Visual Input and Lessons" Height="430" Width="535"
        Background="Gray" ShowInTaskbar="False" FontSize="14">
    <!-- Keep the bottom 32 px clear for ModuleBaseDlg's status/source/help bar. -->
    <Grid Margin="12,12,12,32">
        <TextBlock Text="Observation" Margin="0,5,0,0"
                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <ComboBox x:Name="ObservationBox" Margin="90,0,0,0"
                  Height="27" HorizontalAlignment="Stretch"
                  VerticalAlignment="Top"
                  SelectionChanged="ObservationBox_SelectionChanged"/>

        <TextBlock Text="Distance" Margin="0,43,0,0"
                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <ComboBox x:Name="DistanceBox" Margin="90,37,0,0"
                  Width="55" Height="27" HorizontalAlignment="Left"
                  VerticalAlignment="Top" SelectedIndex="0">
            <ComboBoxItem Content="1"/>
            <ComboBoxItem Content="2"/>
            <ComboBoxItem Content="3"/>
            <ComboBoxItem Content="4"/>
            <ComboBoxItem Content="5"/>
            <ComboBoxItem Content="6"/>
            <ComboBoxItem Content="7"/>
            <ComboBoxItem Content="8"/>
            <ComboBoxItem Content="9"/>
            <ComboBoxItem Content="10"/>
        </ComboBox>
        <Button Content="Present" Margin="155,37,0,0" Width="65" Height="27"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Click="Present_Click"/>
        <Button Content="Clear" Margin="228,37,0,0" Width="55" Height="27"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Click="Clear_Click"/>

        <TextBlock Text="Word" Margin="0,81,0,0"
                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBox x:Name="WordBox" Margin="90,74,80,0" Height="27"
                 HorizontalAlignment="Stretch" VerticalAlignment="Top"
                 VerticalContentAlignment="Center"/>
        <Button x:Name="ImagineButton" Content="Imagine" IsDefault="True"
                Margin="0,74,0,0" Width="70" Height="27"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Click="Imagine_Click"/>

        <TextBlock Text="Lesson" Margin="0,119,0,0" FontWeight="Bold"
                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <ComboBox x:Name="LessonBox" Margin="90,112,0,0"
                  Height="27" HorizontalAlignment="Stretch"
                  VerticalAlignment="Top"
                  SelectionChanged="LessonBox_SelectionChanged"/>

        <ListBox x:Name="LessonStepsList" Margin="0,147,0,39"
                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                 Background="White"
                 BorderBrush="DimGray" Foreground="Black"
                 Focusable="False" IsTabStop="False">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="4,0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="StepBorder"
                                        Padding="{TemplateBinding Padding}"
                                        Background="White"
                                        BorderBrush="Transparent"
                                        BorderThickness="1">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="StepBorder" Property="Background"
                                                Value="#FFFFFF00"/>
                                        <Setter TargetName="StepBorder" Property="BorderBrush"
                                                Value="#FFFF8C00"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <TextBlock Text="Seconds" Margin="0,0,0,10"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
        <ComboBox x:Name="IntervalBox" Margin="67,0,0,5"
                  Width="58" Height="27" HorizontalAlignment="Left"
                  VerticalAlignment="Bottom" SelectedIndex="0"
                  SelectionChanged="IntervalBox_SelectionChanged">
            <ComboBoxItem Content=".1"/>
            <ComboBoxItem Content=".25"/>
            <ComboBoxItem Content=".5"/>
            <ComboBoxItem Content="1"/>
            <ComboBoxItem Content="2"/>
        </ComboBox>
        <Button Content="Step" Margin="137,0,0,5" Width="52" Height="27"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Click="StepLesson_Click"/>
        <Button Content="Run" Margin="195,0,0,5" Width="52" Height="27"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Click="RunLesson_Click"/>
        <Button Content="Pause" Margin="253,0,0,5" Width="58" Height="27"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Click="PauseLesson_Click"/>
        <Button Content="Reset" Margin="317,0,0,5" Width="58" Height="27"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Click="ResetLesson_Click"/>
    </Grid>
</local:ModuleBaseDlg>
