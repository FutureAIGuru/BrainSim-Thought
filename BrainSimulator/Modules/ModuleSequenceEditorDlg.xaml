<local:ModuleBaseDlg x:Class="BrainSimulator.Modules.ModuleSequenceEditorDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BrainSimulator.Modules"
        mc:Ignorable="d"
        Title="Algorithm Editor" Height="400" Width="550" Background="Gray" ShowInTaskbar="False" FontSize="16">

    <Grid Margin="0,0,0,46" >
        <Label Content="Task Name:" Margin="-62,10,0,0" Height="28" VerticalAlignment="Top" HorizontalContentAlignment="Right" HorizontalAlignment="Left" Width="158" />
        <TextBox x:Name="sequenceNameInput" Height="28" VerticalAlignment="Top" Margin="98,10,172,0" />

        <!-- Line numbers TextBox -->
        <TextBox x:Name="lineNumbersTextBox" Width="40" Margin="23,90,0,0" HorizontalAlignment="Left" 
                 IsReadOnly="True" VerticalScrollBarVisibility="Hidden" TextWrapping="NoWrap" 
                 FontFamily="Consolas" 
                 FontSize="16"
                 Background="LightGray" BorderThickness="0,1,0,1" Padding="5,0,5,0" TextAlignment="Right"/>

        <!-- Content TextBox -->
        <TextBox x:Name="sequenceContentInput" 
                 AcceptsReturn="True" 
                 AcceptsTab="True" 
                 VerticalScrollBarVisibility="Auto" 
                 HorizontalScrollBarVisibility="Auto"
                 IsInactiveSelectionHighlightEnabled="True"
                 Background="LightGray"
                 FontFamily="Consolas" 
                 FontSize="16" Margin="68,90,10,0" >
            <TextBox.Resources>
                <!-- Change 'Yellow' to any color you prefer -->
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" 
                         Color="Yellow" />
            </TextBox.Resources>
        </TextBox>

        <Button x:Name="saveButton" Content="Save" Margin="0,10,60,0" HorizontalAlignment="Right" Width="80" Height="28" VerticalAlignment="Top" />

        <!-- Search/Replace controls -->
        <Label Content="Search:" Margin="23,44,0,0" HorizontalAlignment="Left" Width="70" FontSize="14" HorizontalContentAlignment="Right" Height="28" VerticalAlignment="Top" />
        <TextBox x:Name="searchPatternInput" Width="90" Margin="98,46,0,0" HorizontalAlignment="Left" FontSize="14" Height="28" VerticalAlignment="Top" />

        <Label Content="Replace:" Margin="227,44,0,0" HorizontalAlignment="Left" Width="70" FontSize="14" Height="28" VerticalAlignment="Top" />
        <TextBox x:Name="replacePatternInput" Width="90" Margin="288,46,0,0" HorizontalAlignment="Left" FontSize="14" Height="28" VerticalAlignment="Top" />
    </Grid>
</local:ModuleBaseDlg>