<local:ModuleBaseDlg x:Class="BrainSimulator.Modules.ModuleTextDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BrainSimulator.Modules"
        mc:Ignorable="d"
        Title="Text Import" Height="470" Width="640" Background="Gray" ShowInTaskbar="False" >

    <Grid Margin="10,6,10,34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Enter Phrase" FontWeight="Bold" Padding="0,2,0,2"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
            <Label Content="Phrase:" VerticalAlignment="Center" Width="56" Padding="0,0,4,0"/>
            <TextBox x:Name="tbPhrase" AcceptsReturn="False" TextWrapping="NoWrap"
                     PreviewKeyDown="tbPhrase_PreviewKeyDown"
                     Width="300" Height="24" VerticalContentAlignment="Center"/>
            <Button x:Name="btnIngest" Content="Add" Click="BtnAdd_Click"
                    Width="72" Height="24" Margin="6,0,0,0"/>
            <Button x:Name="btnDescribe" Content="Tell Me" Click="BtnDescribe_Click"
                    Width="72" Height="24" Margin="6,0,0,0"/>
            <Button x:Name="btnTrigram" Content="Process" Click="btnTrigram_Click"
                    Width="72" Height="24" Margin="6,0,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="2" TextWrapping="Wrap" Margin="56,0,0,6" Foreground="#FF202020"
                   Text="Add learns a statement. Tell Me answers a question ending in '?', or gives an account of a single word such as: dog"/>

        <Label Grid.Row="3" Content="In English" FontWeight="Bold" Padding="0,2,0,2"/>

        <TextBox Grid.Row="4" x:Name="txtSaid" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"
                 VerticalScrollBarVisibility="Auto" Background="#FFF8F8F8"
                 Margin="0,0,0,8"/>

        <Label Grid.Row="5" Content="Load from File" FontWeight="Bold" Padding="0,2,0,2"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal">
            <Label Content="File:" VerticalAlignment="Center" Width="56" Padding="0,0,4,0"/>
            <TextBox x:Name="txtFilePath" Height="24" IsReadOnly="True" Width="300"
                     Background="#F0F0F0" VerticalContentAlignment="Center"/>
            <Button x:Name="btnBrowse" Content="Browse..." Click="btnBrowse_Click"
                    Width="72" Height="24" Margin="6,0,0,0"/>
            <Button x:Name="btnLoad" Content="Load" Click="btnLoad_Click"
                    Width="72" Height="24" Margin="6,0,0,0"/>
        </StackPanel>
    </Grid>
</local:ModuleBaseDlg>
