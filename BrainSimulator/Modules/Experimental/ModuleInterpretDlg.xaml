<modules:ModuleBaseDlg x:Class="BrainSimulator.Modules.ModuleInterpretDlg"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:modules="clr-namespace:BrainSimulator.Modules"
    Title="Interpret English" Width="680" Height="490" MinWidth="440" MinHeight="320" Background="DarkGray">
    <Grid Margin="12,12,12,40" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Label Content="_English input" Target="{Binding ElementName=EnglishInput}"/>
        <TextBox x:Name="EnglishInput" Grid.Row="1" Margin="0,3,0,8"
                 Text="the black dog is chasing the cat" FontSize="16"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="_Show word sequence" IsDefault="True" Padding="10,3" Click="ShowSequenceClick"/>
        </StackPanel>
        <TextBox x:Name="Output" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" FontSize="16"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Word sequence"/>
    </Grid>
</modules:ModuleBaseDlg>
