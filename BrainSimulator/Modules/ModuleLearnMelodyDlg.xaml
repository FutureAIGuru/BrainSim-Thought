<local:ModuleBaseDlg x:Class="BrainSimulator.Modules.ModuleLearnMelodyDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BrainSimulator.Modules"
        mc:Ignorable="d"
        Title="Learn Melody" Height="300" Width="550" Background="Gray" ShowInTaskbar="False">

    <Grid Margin="0,0,0,20">

        <!-- Header -->
        <Label Content="Learn Melody" FontWeight="Bold" FontSize="14" Margin="16,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="163"/>

        <!-- File Loading Section -->
        <Label Content="Load Melody File" FontWeight="Bold" Margin="16,50,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>

        <Label Content="File:" VerticalAlignment="Top" Width="60" Margin="16,90,0,0" HorizontalAlignment="Left"/>
        <TextBox x:Name="txtFilePath" Height="24" Margin="81,92,0,0" IsReadOnly="True" FontSize="16"
                 VerticalAlignment="Top" Background="#F0F0F0" HorizontalAlignment="Left" Width="250"/>
        <Button x:Name="btnBrowse" Content="Browse..." Click="btnBrowse_Click" Width="75" Height="25"
                Margin="346,92,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <Button x:Name="btnLoad" Content="Load" Click="btnLoad_Click" Width="75" Height="25"
                Margin="426,92,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>

    </Grid>
</local:ModuleBaseDlg>