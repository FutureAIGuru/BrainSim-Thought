<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UKS\UKS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Tests\InheritanceCh5RegressionTests.cs" Link="InheritanceCh5RegressionTests.cs" />
    <Compile Include="..\Tests\InheritanceCh5PhaseDRegressionTests.cs" Link="InheritanceCh5PhaseDRegressionTests.cs" />
    <!-- The Phase D context tests use ModuleAlgorithm's context resolver, which needs only the UKS. -->
    <Compile Include="..\BrainSimulator\Modules\ModuleAlgorithm.ContextResolver.cs" Link="ModuleAlgorithm.ContextResolver.cs" />
    <Compile Include="..\Tests\InheritanceCh5PhaseERegressionTests.cs" Link="InheritanceCh5PhaseERegressionTests.cs" />
    <Compile Include="..\Tests\UKSFixesRegressionTests.cs" Link="UKSFixesRegressionTests.cs" />
    <Compile Include="..\Tests\UKSExclusivityTests.cs" Link="UKSExclusivityTests.cs" />
    <Compile Include="..\Tests\UKS.TextFile.Tests.cs" Link="UKS.TextFile.Tests.cs" />
    <Compile Include="..\Tests\UKSSequenceTests.cs" Link="UKSSequenceTests.cs" />
    <Compile Include="..\Tests\UKSConditionalTests.cs" Link="UKSConditionalTests.cs" />
    <Compile Include="..\Tests\NatureAnimalsXmlTests.cs" Link="NatureAnimalsXmlTests.cs" />
    <Compile Include="..\Tests\NonUksP2FixesRegressionTests.cs" Link="NonUksP2FixesRegressionTests.cs" />
  </ItemGroup>

  <!-- ModuleInterpret runs headlessly against ModuleBaseStub.cs; it needs only the UKS,
       ModuleWord's spelling lookup, Pluralize.NET, and the vocabulary file. -->
  <ItemGroup>
    <PackageReference Include="Pluralize.NET" Version="1.0.2" />
    <Compile Include="..\BrainSimulator\Modules\Experimental\ModuleInterpret.cs" Link="Modules\ModuleInterpret.cs" />
    <Compile Include="..\BrainSimulator\Modules\ModuleWord.Spelling.cs" Link="Modules\ModuleWord.Spelling.cs" />
    <None Include="..\BrainSimulator\UKSContent\BasicWords.txt" Link="UKSContent\BasicWords.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\BrainSimulator\UKSContent\InterpretTrials.txt" Link="UKSContent\InterpretTrials.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
