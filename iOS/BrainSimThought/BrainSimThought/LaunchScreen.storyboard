        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23506"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--Launch Screen: the splash purple with the Brain Simulator logo centered.
            SplashView (SwiftUI) starts from this exact frame and then reveals the full splash.-->
        <scene sceneID="LSc-Sc-001">
            <objects>
                <viewController id="LSc-Vc-001" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="LSc-Vw-001">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="LaunchLogo" translatesAutoresizingMaskIntoConstraints="NO" id="LSc-Im-001">
                                <rect key="frame" x="121.66666666666669" y="351" width="150" height="150"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="150" id="LSc-Cn-001"/>
                                    <constraint firstAttribute="height" constant="150" id="LSc-Cn-002"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="LSc-Sa-001"/>
                        <color key="backgroundColor" name="SplashBackground"/>
                        <constraints>
                            <constraint firstItem="LSc-Im-001" firstAttribute="centerX" secondItem="LSc-Vw-001" secondAttribute="centerX" id="LSc-Cn-003"/>
                            <constraint firstItem="LSc-Im-001" firstAttribute="centerY" secondItem="LSc-Vw-001" secondAttribute="centerY" id="LSc-Cn-004"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="LSc-Fr-001" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="0" y="0"/>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchLogo" width="150" height="150"/>
        <namedColor name="SplashBackground">
            <color red="0.149" green="0.055" blue="0.349" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>
